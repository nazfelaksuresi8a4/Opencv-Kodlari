import cv2
import numpy as np

# Kamerayı aç
kamera = cv2.VideoCapture(0)

while True:
    ret, frame = kamera.read()

    if not ret:
        print("Kamera açılamadı!")
        break

    # BGR -> HSV
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Kırmızı rengin HSV aralıkları
    lower_red1 = np.array([0, 100, 80])
    upper_red1 = np.array([10, 255, 255])

    lower_red2 = np.array([170, 100, 80])
    upper_red2 = np.array([180, 255, 255])

    # Kırmızı maskeleri
    mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
    mask2 = cv2.inRange(hsv, lower_red2, upper_red2)

    mask = mask1 + mask2

    # Gürültüyü azalt
    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    # Konturları bul
    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    # En büyük kırmızı nesneyi bul
    if contours:
        en_buyuk = max(contours, key=cv2.contourArea)
        alan = cv2.contourArea(en_buyuk)

        # Çok küçük nesneleri dikkate alma
        if alan > 300:

            x, y, w, h = cv2.boundingRect(en_buyuk)

            # Merkez koordinatı
            merkez_x = x + w // 2
            merkez_y = y + h // 2

            # Kalemin etrafına kutu
            cv2.rectangle(
                frame,
                (x, y),
                (x + w, y + h),
                (0, 255, 0),
                2
            )

            # Merkez noktası
            cv2.circle(
                frame,
                (merkez_x, merkez_y),
                7,
                (255, 0, 0),
                -1
            )

            # Yazı
            cv2.putText(
                frame,
                "KIRMIZI KALEM",
                (x, y - 10),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.7,
                (0, 255, 0),
                2
            )

            # Koordinat
            cv2.putText(
                frame,
                f"X: {merkez_x} Y: {merkez_y}",
                (x, y + h + 25),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (255, 255, 255),
                2
            )

            print(f"Kalem bulundu -> X: {merkez_x}, Y: {merkez_y}")

    # Görüntüyü göster
    cv2.imshow("Kamera", frame)
    cv2.imshow("Kirmizi Maske", mask)

    # Q ile çık
    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

kamera.release()
cv2.destroyAllWindows()
